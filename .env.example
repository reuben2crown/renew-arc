
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... 
# ⚠️ WARNING: Never expose SERVICE_ROLE_KEY to the client (browser)

# ==========================================
# 2. PAYMENTS (Dodo Payments - Primary)
# ==========================================
DODO_API_KEY=dodo_live_...
DODO_WEBHOOK_SECRET=whsec_...
DODO_MERCHANT_ID=merch_...
# Backup Provider (Optional)
PADDLE_API_KEY=paddle_live_...
PADDLE_ENVIRONMENT=production # or 'sandbox' for testing

# ==========================================
# 3. OCR (Google Cloud Vision)
# ==========================================
GOOGLE_VISION_API_KEY=AIzaSy...
# Optional: If using Service Account JSON instead of API Key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==========================================
# 4. NOTIFICATIONS
# ==========================================
# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15550000000

# ==========================================
# 5. ANALYTICS & MONITORING
# ==========================================
# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=renewpilot
# Product Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==========================================
# 6. SECURITY & CRON JOBS
# ==========================================
# Secret key to verify Vercel Cron requests
CRON_SECRET=generate_a_strong_random_string_here
# NextAuth Secret (if using custom auth logic)
NEXTAUTH_SECRET=generate_another_random_string
NEXTAUTH_URL=https://your-production-domain.com

# ==========================================
# 7. APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NODE_ENV=production
